{
    "name": "cursor-love2d-debug",
    "displayName": "Love2D Debugger",
    "description": "Debug Love2D (LuaJIT) games in Cursor with breakpoints, stepping and variable inspection",
    "version": "0.1.0",
    "publisher": "nightowl",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Debuggers"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onDebug"
    ],
    "scripts": {
        "compile": "tsc -p .",
        "watch": "tsc -w -p .",
        "package": "vsce package"
    },
    "contributes": {
        "breakpoints": [
            {
                "language": "lua"
            }
        ],
        "debuggers": [
            {
                "type": "love2d",
                "label": "Love2D Debugger",
                "languages": [
                    "lua"
                ],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "projectRoot": {
                                "type": "string",
                                "description": "Love2D 项目目录（包含 main.lua）",
                                "default": "${workspaceFolder}"
                            },
                            "lovePath": {
                                "type": "string",
                                "description": "love/lovec 可执行文件路径",
                                "default": "lovec"
                            },
                            "args": {
                                "type": "array",
                                "description": "传给游戏的额外命令行参数",
                                "default": []
                            },
                            "port": {
                                "type": "number",
                                "description": "调试器 TCP 端口",
                                "default": 56789
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "启动后立即暂停",
                                "default": false
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "love2d",
                        "request": "launch",
                        "name": "Debug Love2D",
                        "projectRoot": "${workspaceFolder}"
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Love2D: Launch",
                        "description": "启动并调试 Love2D 游戏",
                        "body": {
                            "type": "love2d",
                            "request": "launch",
                            "name": "Debug Love2D",
                            "projectRoot": "^\"\\${workspaceFolder}\""
                        }
                    }
                ]
            }
        ]
    },
    "dependencies": {
        "@vscode/debugadapter": "^1.68.0",
        "@vscode/debugprotocol": "^1.68.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.5.0"
    }
}
